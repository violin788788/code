**/*.pdf
**/*.epub
**/*.exe
*.pyc
*.pyo
*.png
**/*.png
*.jpg
**/*.jpg
*.onnx
**/*.onnx
*.wav
**/*.wav
*.xml
**/*.xml
*.dat
**/*.dat
*.mp4
**/*.mp4




# Ignore virtual environments
.venv/
.env/
virtualenv/

# Ignore common cache/config directories
.cache/
.config/
.ipython/
.local/
.virtualenvs/

# Ignore IDE folders
.vscode/
.idea/

# Ignore system files
.lesshst
.bashrc
.vimrc
.profile
.pythonstartup.py